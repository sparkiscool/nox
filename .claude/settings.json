{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "PYTHONUNBUFFERED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(bash cloud/*)",
      "Bash(pip install *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh api repos/sparkiscool/nox/pulls/*)",
      "Bash(gh api -X PUT repos/sparkiscool/nox/pulls/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash cloud/session_start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Merging a pull request of sparkiscool/nox into main with gh pr merge or the GitHub REST merge call, after the repo's review agent reported PASS on it (CLAUDE.md step 4: review then merge)."
    ]
  }
}
