# Copy to .env and export, or put these in the "env" block of your MCP config.
# All optional. Cart links and the catalog work with nothing set.

AMAZON_PARTS_DATA=/absolute/path/amazon-parts-mcp/data/catalog.json
AMAZON_DOMAIN=www.amazon.com
AMAZON_ASSOCIATE_TAG=

# Product Advertising API 5.0 (live search and prices)
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_HOST=webservices.amazon.com
PAAPI_REGION=us-east-1

# Amazon Business Ordering API (direct purchase). Leave blank unless approved by Amazon Business.
AB_CLIENT_ID=
AB_CLIENT_SECRET=
AB_REFRESH_TOKEN=
AB_HOST=na.business-api.amazon.com
AMAZON_PARTS_ALLOW_ORDERS=0
